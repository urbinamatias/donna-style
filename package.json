{
  "name": "donna-style",
  "version": "0.1.0",
  "private": true,
  "description": "Donna Style — tienda online de indumentaria femenina",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
    "build:css": "tailwindcss -i src/public/css/input.css -o src/public/css/output.css --minify",
    "watch:css": "tailwindcss -i src/public/css/input.css -o src/public/css/output.css --watch",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
