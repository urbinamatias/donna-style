<%# Listado de categorías (spec admin-categories). Sin JS: reorder por drag
  queda para un futuro incremento — Fase 6a persiste sort_order vía input
  numérico en el form, alcanza para el criterio de aceptación "reorder
  siblings" sin agregar un script nuevo. %>
<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h1 class="font-brand text-3xl">Categorías</h1>
    <a href="/admin/categorias/nueva" class="rounded-lg bg-brand px-4 py-2 text-base font-semibold text-brandInk">+ Nueva</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <p class="rounded border-2 border-error bg-white px-4 py-3 text-base text-error"><%= error %></p>
  <% } %>

  <ul class="flex flex-col gap-3">
    <% categories.forEach(function (category) { %>
      <li class="flex items-center justify-between rounded-lg border-2 border-border bg-surface p-4">
        <div>
          <p class="text-lg font-medium"><%= category.name %></p>
          <p class="text-sm text-textMuted">
            /<%= category.slug %><% if (category.parent_id) { %> — nivel 2<% } %>
          </p>
        </div>
        <div class="flex items-center gap-4 text-base">
          <a href="/admin/categorias/<%= category.id %>/editar" class="underline">Editar</a>
          <form method="POST" action="/admin/categorias/<%= category.id %>/eliminar"
                data-confirm="¿Borrar esta categoría?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="rounded-lg bg-error px-3 py-1.5 text-sm font-semibold text-white">Borrar</button>
          </form>
        </div>
      </li>
    <% }) %>
    <% if (categories.length === 0) { %>
      <li class="text-base text-textMuted">Todavía no hay categorías.</li>
    <% } %>
  </ul>
</div>
