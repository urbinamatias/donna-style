<%# ------------------------------------------------------------------
  Página /carrito completa (§5.7), alternativa al drawer. `summary` y
  `notices` ya vienen revalidados contra stock vivo desde cart.js (route).
  Los forms son server-rendered directos (funcionan sin JS, POST → 303 de
  vuelta acá); con JS, cart.js los intercepta con el mismo listener
  delegado que usa el drawer (data-cart-form).

  Los contenedores llevan los MISMOS data-attributes que cart-drawer.ejs
  (data-cart-notices/-empty/-lines/-footer/-subtotal): cart.js actualiza
  TODOS los elementos que matchean esos selectors en el documento, no solo
  el primero. Ambas ramas (vacío/con líneas) se renderizan siempre, una
  oculta con `hidden`, igual que el drawer — si solo existiera la rama
  correcta en el DOM (como antes), tras la primera actualización JS
  quedaría sin dónde mostrar la otra rama.
------------------------------------------------------------------ %>
<section class="mx-auto max-w-[1400px] px-4 py-8">
  <h1 class="mb-6 text-2xl font-semibold">Carrito</h1>

  <div aria-live="polite" data-cart-notices class="mb-4 flex flex-col gap-2 empty:hidden">
    <% (notices || []).forEach(function (notice) { %>
      <p class="rounded border border-border-strong bg-bg px-3 py-2 text-sm text-error">
        <% if (notice.kind === 'removed') { %>
          <%= notice.name || 'Un producto' %> se agotó y fue quitado del carrito.
        <% } else { %>
          <%= notice.name || 'Un producto' %>: la cantidad se ajustó a <%= notice.to %> por stock disponible.
        <% } %>
      </p>
    <% }) %>
  </div>

  <div data-cart-empty class="flex flex-col items-center gap-3 py-16 text-center <%= summary.lines.length === 0 ? '' : 'hidden' %>">
    <p class="text-textMuted">Todavía no agregaste nada.</p>
    <a href="/" class="rounded px-4 py-2 text-sm font-semibold text-text" style="background: var(--brand-gradient);">Ver catálogo</a>
  </div>

  <ul data-cart-lines class="mb-6 flex flex-col divide-y divide-border border-y border-border <%= summary.lines.length === 0 ? 'hidden' : '' %>">
    <% summary.lines.forEach(function (line) { %>
      <li class="flex gap-4 py-4">
        <% if (line.image) { %>
          <img src="<%= line.image %>" alt="" class="h-24 w-18 shrink-0 rounded object-cover">
        <% } %>
        <div class="flex flex-1 flex-col gap-1">
          <p class="font-medium"><%= line.name %></p>
          <% if (line.size || line.color) { %>
            <p class="text-sm text-textMuted"><%= [line.size, line.color].filter(Boolean).join(' / ') %></p>
          <% } %>
          <p class="text-sm"><%= formatPrice(line.price) %> c/u</p>

          <div class="mt-2 flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <form data-cart-form action="/carrito/actualizar" method="post" class="flex items-center gap-2" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="variant_id" value="<%= line.variantId %>">
                <label class="sr-only" for="qty-<%= line.variantId %>">Cantidad de <%= line.name %></label>
                <input type="number" id="qty-<%= line.variantId %>" name="quantity" min="1" max="<%= line.stock %>" value="<%= line.quantity %>" class="w-16 rounded border border-border px-2 py-1 text-sm">
                <button type="submit" class="inline-flex items-center min-h-[24px] px-2 py-1 text-xs font-medium text-brandInk underline">Actualizar</button>
                <p data-add-error aria-live="polite" class="text-xs font-medium text-error empty:hidden"></p>
              </form>
              <form data-cart-form action="/carrito/eliminar" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="variant_id" value="<%= line.variantId %>">
                <button type="submit" class="inline-flex items-center min-h-[24px] px-2 py-1 text-xs font-medium text-error underline">Quitar</button>
              </form>
            </div>
          </div>
        </div>
        <span class="shrink-0 font-semibold"><%= formatPrice(line.lineTotal) %></span>
      </li>
    <% }) %>
  </ul>

  <div data-cart-footer class="flex flex-col items-end gap-3 <%= summary.lines.length === 0 ? 'hidden' : '' %>">
    <div class="flex items-baseline justify-end gap-3 text-lg font-semibold">
      <span>Subtotal</span>
      <span data-cart-subtotal><%= formatPrice(summary.subtotal) %></span>
    </div>
    <%# Fase 5 (§5.8): oculto cuando el carrito está vacío, mismo criterio
        que el resto de data-cart-footer — cart.js no re-renderiza este CTA
        dinámicamente, solo togglea `hidden` en el contenedor completo. %>
    <a href="/checkout" class="w-full rounded px-4 py-3 text-center text-sm font-semibold text-text sm:w-auto" style="background: var(--brand-gradient);">
      Finalizar pedido
    </a>
  </div>
</section>
