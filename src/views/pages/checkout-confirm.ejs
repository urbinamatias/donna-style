<%# ------------------------------------------------------------------
  Confirmación de checkout (§5.8 pasos 5-6, design.md D5). Deviation
  DELIBERADA de §5.8 paso 4: nunca hay un redirect automático del servidor
  a wa.me — esta página siempre se renderiza primero, con el link
  clickeable y el aviso de "tocá enviar" bien visible, para que ese aviso
  no se pierda detrás de un salto automático de pestaña.
------------------------------------------------------------------ %>
<section class="mx-auto max-w-[720px] px-4 py-12 text-center">
  <h1 class="mb-2 text-2xl font-semibold">¡Gracias por tu pedido!</h1>
  <p class="mb-6 text-textMuted">Pedido <strong class="text-text"><%= order.order_code %></strong> registrado.</p>

  <div class="mb-8 rounded border border-border-strong bg-bg px-4 py-4 text-left text-sm">
    <p class="font-semibold">Importante: tenés que tocar "Enviar" en WhatsApp.</p>
    <p class="mt-1 text-textMuted">
      El botón de abajo abre WhatsApp con el mensaje ya escrito, pero todavía no se mandó. Si no lo enviás, no nos vamos a enterar del pedido.
    </p>
  </div>

  <a
    href="<%= waLink %>"
    target="_blank"
    rel="noopener"
    class="mb-4 inline-block w-full rounded px-4 py-3 text-sm font-semibold text-text sm:w-auto"
    style="background: var(--brand-gradient);"
  >
    Abrir WhatsApp y enviar el pedido
  </a>

  <p>
    <a href="<%= orderUrl %>" class="text-sm font-medium text-brandInk underline">Ver el detalle de tu pedido</a>
  </p>
</section>
