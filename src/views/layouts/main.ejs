<%# ------------------------------------------------------------------
  Layout compartido (§9). Activado en Fase 3: cada ruta publica renderiza
  este archivo pasando "view" (path relativo a /views de la pagina real) +
  sus locals; el layout compone header/footer alrededor con include().
  include() es composicion de templates ya controlados por el proyecto,
  no salida de datos dinamicos sin sanitizar - la regla de escapar siempre
  sigue aplicando DENTRO de cada partial para cualquier dato real (§8.1).
------------------------------------------------------------------ %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
  <meta name="description" content="<%= metaDescription %>">
  <% } %>
  <%# Fase 5 (design.md D6): mismo patrón opcional que metaDescription — el
      pedido público (`/pedido/:token`) y la confirmación de checkout pasan
      `noindex: true` para que el buscador no indexe URLs con token. %>
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex">
  <% } %>
  <link rel="icon" href="/img/logo-cuadrado.png">
  <link rel="stylesheet" href="/css/output.css">
  <%# Fase 4: token CSRF disponible para cart.js/variant-selector.js sin
      tener que repetirlo como input oculto en cada form generado por JS
      (design.md D3 — header estándar, no dato dinámico peligroso). %>
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="bg-bg text-text min-h-screen flex flex-col">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-surface focus:text-text focus:p-3">Saltar al contenido</a>
  <%- include('../partials/header') %>
  <main id="main-content" class="flex-1">
    <%- include(view, locals) %>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/menu-animate.js" defer></script>
  <%# Fase 4: cargados en toda página porque el drawer vive en el header
      (cart.js) y las cards de producto pueden aparecer en home/categoría/
      ficha (variant-selector.js) — ambos no-opean si no encuentran sus
      elementos data-* en el DOM. %>
  <script src="/js/variant-selector.js" defer></script>
  <script src="/js/cart.js" defer></script>
  <% if (typeof bodyScripts !== 'undefined') { %>
    <% bodyScripts.forEach(function (src) { %>
      <script src="<%= src %>" defer></script>
    <% }) %>
  <% } %>
</body>
</html>
