<%# ------------------------------------------------------------------
  Card de producto (§5.5). Recibe `product` ya "enriquecido" en la capa de
  rutas (attachCardData en public.js): { ...row, images, variants,
  availability }. Sin selector de talle/color ni form de agregar al carrito
  (obs #406/#407): la card solo muestra precio de lista, precio con
  transferencia/efectivo, valor de cuota, y un link "Ver producto" a la
  ficha, donde vive la interacción real de variantes/stock.
------------------------------------------------------------------ %>
<%
  const primaryImage = product.images.find((img) => img.is_primary) || product.images[0] || null;
  const hasDiscount = product.compare_at_price !== null && product.compare_at_price !== undefined;
  const discountPct = hasDiscount
    ? Math.round((1 - Number(product.base_price) / Number(product.compare_at_price)) * 100)
    : 0;
  const defaultVariant = product.variants.find((v) =>
    Object.entries(product.availability.defaultSelection).every(([axis, val]) => v[axis] === val)
  );
  const effectivePrice = defaultVariant && defaultVariant.price_override !== null
    ? defaultVariant.price_override
    : product.base_price;
  // D3 (design #407): transferencia/cuotas se calculan sobre `base_price`,
  // nunca sobre `effectivePrice` — mostrar un incentivo atado a una
  // variante arbitraria sin selector sería engañoso.
  const transferPrice = computeTransferPrice(product.base_price);
  const installmentValue = computeInstallmentValue(product.base_price);
%>
<article class="group/card flex h-full flex-col overflow-hidden rounded-md border border-border bg-surface">
  <a href="/productos/<%= product.slug %>"
     class="card-media relative block aspect-[3/4] overflow-hidden bg-bg">
    <%
      // Fase 6b (spec "Card srcset"): 400/800 vía el único helper compartido
      // (app.locals.imageAttrs) — nunca se concatena ancho/.webp acá.
      //
      // QA fase 6c: había una segunda foto que se mostraba al pasar el mouse
      // (crossfade opacity). Pese a dos intentos de arreglo (loading="lazy",
      // will-change), seguía viéndose como un parpadeo incluso con dos fotos
      // idénticas — decisión explícita de sacar la reacción al hover del
      // todo: la card solo reacciona al click para entrar a la ficha.
      const primaryAttrs = primaryImage
        ? imageAttrs(product.id, primaryImage.base_key, { widths: [400, 800], sizes: '(min-width: 1024px) 25vw, 50vw' })
        : null;
    %>
    <% if (primaryAttrs) { %>
      <img
        src="<%= primaryAttrs.src %>"
        srcset="<%= primaryAttrs.srcset %>"
        sizes="<%= primaryAttrs.sizes %>"
        alt="<%= (primaryImage.alt_text && primaryImage.alt_text.trim()) || product.name %>"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      >
    <% } else { %>
      <span class="sr-only"><%= product.name %></span>
    <% } %>
    <div class="absolute left-2 top-2 flex flex-col gap-1">
      <% if (hasDiscount) { %>
        <span class="rounded bg-text px-2 py-1 text-xs font-semibold text-bg"><%= discountPct %>% OFF</span>
      <% } %>
      <% if (product.free_shipping) { %>
        <span class="rounded border border-border-strong bg-surface px-2 py-1 text-xs font-medium">Envío gratis</span>
      <% } %>
      <% if (!product.availability.hasAnyStock) { %>
        <span class="rounded border border-border-strong bg-surface px-2 py-1 text-xs font-medium text-textMuted">Sin stock</span>
      <% } %>
    </div>
  </a>

  <div class="flex flex-1 flex-col gap-2 p-3">
    <h3 class="text-sm font-medium">
      <a href="/productos/<%= product.slug %>" class="hover:text-brandInk focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-ink)]"><%= product.name %></a>
    </h3>

    <div class="flex items-baseline gap-2">
      <span class="text-xl font-semibold"><%= formatPrice(effectivePrice) %></span>
      <% if (hasDiscount) { %>
        <span class="text-sm text-textMuted line-through"><%= formatPrice(product.compare_at_price) %></span>
      <% } %>
    </div>

    <% if (transferPrice !== null) { %>
      <p class="text-success font-semibold">
        <%= formatPrice(transferPrice) %>
        <span class="text-xs text-textMuted font-normal">Efectivo/Transferencia</span>
      </p>
    <% } %>

    <% if (installmentValue !== null) { %>
      <p class="text-sm text-textMuted">
        6 cuotas sin interés de <span class="font-semibold text-text"><%= formatPrice(installmentValue) %></span>
      </p>
    <% } %>

    <a href="/productos/<%= product.slug %>" class="mt-auto block w-full rounded bg-[var(--brand-gradient)] px-3 py-2 text-center text-sm font-semibold text-text">
      Ver producto
    </a>
  </div>
</article>
