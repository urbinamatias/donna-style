<%# ------------------------------------------------------------------
  Carrusel de promociones (§5.3). `slides` = carouselSlidesModel.findActive().
  0 slides → esta vista no renderiza nada (ni wrapper, ni altura reservada,
  §4.5). 1 slide → imagen fija, cero JS. 2+ → carrusel completo, carga
  carousel.js (wireado desde pages/home.ejs vía bodyScripts).

  QA fase 6d, ronda 2 (corrige el enfoque original de Fase 6d): los slides
  son piezas de diseño ya armadas por la dueña (banners de Canva/similar
  sobre promociones), no fotos de celular — recortarlos a una relación de
  aspecto fija les cortaba texto/logos del diseño. Cada imagen se muestra
  SIEMPRE completa (`object-contain`, nunca `cover`) dentro de un
  contenedor de alto fijo (evita que el carrusel "salte" de tamaño al rotar
  entre slides de proporciones distintas) — si la proporción de la imagen
  no llena el contenedor, queda espacio de fondo a los costados o arriba/
  abajo, nunca se pierde contenido del diseño. Un solo derivado por slide
  (perfil `carousel` de `services/images.js`), sin versión mobile aparte:
  sin recorte no hay nada que "adaptar" por dispositivo.
------------------------------------------------------------------ %>
<% if (slides.length === 1) { %>
  <% const slide = slides[0]; %>
  <% const attrs = slideImageAttrs(slide.base_key); %>
  <div class="mx-auto max-w-[1400px] px-4 py-4">
    <% if (slide.link_url) { %><a href="<%= slide.link_url %>"><% } %>
      <div class="aspect-[4/5] md:aspect-[2.5/1] w-full overflow-hidden rounded-md bg-bg">
        <img
          src="<%= attrs.src %>"
          srcset="<%= attrs.srcset %>"
          sizes="100vw"
          alt="<%= slide.alt_text %>"
          fetchpriority="high"
          class="h-full w-full object-contain"
        >
      </div>
    <% if (slide.link_url) { %></a><% } %>
  </div>
<% } else if (slides.length >= 2) { %>
  <div class="mx-auto max-w-[1400px] px-4 py-4">
    <div
      data-carousel
      class="relative overflow-hidden rounded-md bg-bg aspect-[4/5] md:aspect-[2.5/1]"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Promociones"
    >
      <% slides.forEach(function (slide, i) { %>
        <% const attrs = slideImageAttrs(slide.base_key); %>
        <div data-carousel-slide class="absolute inset-0 transition-opacity duration-200<% if (i !== 0) { %> opacity-0 pointer-events-none<% } %>" aria-hidden="<%= i !== 0 %>">
          <% if (slide.link_url) { %><a href="<%= slide.link_url %>" class="block h-full w-full"><% } %>
            <img
              src="<%= attrs.src %>"
              srcset="<%= attrs.srcset %>"
              sizes="100vw"
              alt="<%= slide.alt_text %>"
              <% if (i === 0) { %>fetchpriority="high"<% } else { %>loading="lazy"<% } %>
              class="h-full w-full object-contain"
            >
          <% if (slide.link_url) { %></a><% } %>
        </div>
      <% }) %>

      <button type="button" data-carousel-prev aria-label="Slide anterior" class="hidden md:flex absolute left-2 top-1/2 -translate-y-1/2 h-9 w-9 items-center justify-center rounded-full bg-surface/90 shadow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 fill-current"><path d="M12 3l-7 7 7 7"/></svg>
      </button>
      <button type="button" data-carousel-next aria-label="Slide siguiente" class="hidden md:flex absolute right-2 top-1/2 -translate-y-1/2 h-9 w-9 items-center justify-center rounded-full bg-surface/90 shadow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 fill-current"><path d="M8 3l7 7-7 7"/></svg>
      </button>

      <div data-carousel-dots class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2">
        <% slides.forEach(function (slide, i) { %>
          <button
            type="button"
            data-carousel-dot
            aria-label="Ir al slide <%= i + 1 %>"
            aria-current="<%= i === 0 %>"
            class="h-2.5 w-2.5 rounded-full <%= i === 0 ? 'bg-brand' : 'bg-surface/80' %>"
          ></button>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>
