<%# ------------------------------------------------------------------
  Categorías/subcategorías (§0.1, §5.1). Vive dentro del drawer lateral
  (nav-drawer.ejs) como un ítem más de la lista — ya no es un panel
  flotante propio. "Productos" es la única entrada de nivel superior
  (§0.1 último párrafo). Click/tap para abrir (nunca hover); mismo
  patrón <details> anidado + animación (menu-animate.js) que antes,
  solo que ahora es un acordeón inline en vez de un panel absoluto.

  Primer click en "Productos": lista con las 5 categorías padre, en el
  orden real de §0.1 (viene de categories.findMenuTree, ORDER BY
  sort_order). Click en una con hijos abre un segundo nivel anidado con
  "Ver todo en {categoría}" + sus subcategorías (el link "Ver todo" se
  sintetiza ACÁ, nunca en el modelo — §0.1 regla 1). Click en una sin
  hijos (Noche, 2x1) navega directo, sin flecha ni panel.
------------------------------------------------------------------ %>
<details class="group" data-menu>
  <summary class="flex list-none cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium uppercase tracking-wide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]">
    Productos
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3 w-3 fill-current transition-transform group-open:rotate-180"><path d="M5 7l5 6 5-6z"/></svg>
  </summary>

  <div data-menu-panel>
    <ul>
      <% menuTree.forEach(function (parent) { %>
        <li class="border-t border-border">
          <% if (parent.children.length > 0) { %>
            <details class="group/child" data-menu>
              <summary class="flex list-none cursor-pointer items-center justify-between px-6 py-2.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]">
                <%= parent.name %>
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3 w-3 shrink-0 -rotate-90 fill-current transition-transform group-open/child:rotate-0"><path d="M5 7l5 6 5-6z"/></svg>
              </summary>
              <div data-menu-panel>
                <ul class="bg-bg pb-1">
                  <li>
                    <a href="/<%= parent.slug %>" class="block px-8 py-2 text-sm font-semibold text-brandInk hover:underline">Ver todo en <%= parent.name %></a>
                  </li>
                  <% parent.children.forEach(function (child) { %>
                    <li>
                      <a href="/<%= parent.slug %>/<%= child.slug %>" class="block px-8 py-2 text-sm hover:text-brandInk focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]"><%= child.name %></a>
                    </li>
                  <% }) %>
                </ul>
              </div>
            </details>
          <% } else { %>
            <a href="/<%= parent.slug %>" class="block px-6 py-2.5 text-sm font-medium hover:text-brandInk focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]"><%= parent.name %></a>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
</details>
