<%# ------------------------------------------------------------------
  Header (§5.1): barra de anuncios + header sticky con logo + menú de
  categorías. El ícono de carrito se sumó en Fase 4; el buscador
  (search-toggle.ejs), en la fase ui-brand-search-whatsapp — ambos
  gateados por `hideFloatingUI` (carrito/checkout/pedido/admin).

  El ícono de 3 líneas a la izquierda abre el drawer lateral
  (nav-drawer.ejs), que contiene "Inicio" y "Productos" — este último
  ya no vive suelto en el header. El wordmark queda centrado de
  verdad: posicionado en absoluto respecto del propio header, no por
  balance de flex (que dependería de que ambos lados pesen igual).
------------------------------------------------------------------ %>
<%
  var items = typeof announcementItems !== 'undefined' ? announcementItems : [];
  // El truco de "duplicar y desplazar -50%" solo es continuo si cada mitad
  // ya es más ancha que la pantalla; si el texto es corto, queda hueco a
  // la derecha antes de reiniciar. Repetimos la tanda de mensajes varias
  // veces por mitad para garantizar que siempre sobre texto, sin importar
  // el ancho de pantalla ni cuántos mensajes haya cargados.
  var REPEATS = 6;
  var repeatedItems = [];
  for (var r = 0; r < REPEATS; r++) repeatedItems = repeatedItems.concat(items);
%>
<% if (items.length > 0) { %>
  <div class="overflow-hidden bg-[var(--brand-gradient)] py-2 text-sm font-medium uppercase tracking-wide text-text">
    <div class="marquee flex w-max">
      <div class="flex shrink-0 items-center">
        <% repeatedItems.forEach(function (item) { %>
          <span class="px-6"><%= item %></span>
        <% }) %>
      </div>
      <div class="flex shrink-0 items-center" aria-hidden="true">
        <% repeatedItems.forEach(function (item) { %>
          <span class="px-6"><%= item %></span>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>
<%# El difuminado (backdrop-blur) va en una capa de fondo aparte, no en
    <header> directamente: backdrop-filter crea un "containing block"
    para los descendientes con position:fixed, así que si el drawer
    (nav-drawer.ejs) fuera descendiente de un elemento con blur, su panel
    fixed quedaría encerrado en el alto del header en vez de ocupar toda
    la ventana. Al ser la capa de fondo un hermano del contenido (no un
    ancestro del drawer), el header queda transparente + difuminado sin
    romper el panel. %>
<header class="sticky top-0 z-30 border-b border-border">
  <%# Bug real de QA (mismo hallazgo que product-lightbox.ejs): bg-surface/60
    nunca compilaba — `surface` está declarado en tailwind.config.js como
    var(--surface) sin el formato RGB-triplet que Tailwind necesita para
    combinar un color de tema con un modificador de opacidad. bg-white/60
    es funcionalmente idéntico (--surface es #ffffff) y sí compila. %>
  <div class="absolute inset-0 -z-10 bg-white/60 backdrop-blur-sm"></div>
  <div class="relative mx-auto flex max-w-[1400px] items-center px-6 py-3 sm:px-8">
    <div class="flex items-center">
      <%- include('./nav-drawer', { menuTree: typeof menuTree !== 'undefined' ? menuTree : [] }) %>
      <%- include('./search-toggle') %>
    </div>

    <a href="/" class="absolute left-1/2 -translate-x-1/2 shrink-0">
      <%- include('./wordmark', { size: 'md' }) %>
    </a>

    <%# Fase 4: ícono de carrito reintroducido (removido a propósito en Fase
        3). `absolute right-0`, hermano de nav-drawer dentro del mismo
        contenedor `.relative` — nunca descendiente de la capa
        `backdrop-blur-sm` de arriba (technical note de Fase 3: eso
        encerraría el panel `fixed` del drawer al alto del header). %>
    <div class="absolute right-0">
      <%- include('./cart-drawer', { cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>
    </div>
  </div>
</header>
