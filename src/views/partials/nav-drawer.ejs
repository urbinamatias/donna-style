<%# ------------------------------------------------------------------
  Drawer lateral de navegación (§4.4 "drawer con acordeones en mobile",
  ahora también en desktop a pedido explícito). Ícono de 3 líneas a la
  izquierda del header abre, con click/tap, un panel desde la izquierda
  con "Inicio" y "Productos" (el drill-down de categorías/subcategorías
  vive DENTRO, en mega-menu.ejs, con el mismo patrón <details> anidado +
  animación de antes). Clic fuera del panel (en el fondo oscuro) lo
  cierra. Base <details>/<summary>: funciona sin JS (toggle instantáneo,
  sin fondo ni cierre-al-click-afuera, degradación aceptable); con JS,
  menu-animate.js anima entrada/salida (§4.3, 280ms/220ms) y agrega el
  cierre por click afuera + Escape.
------------------------------------------------------------------ %>
<details data-menu>
  <summary
    aria-label="Abrir menú"
    aria-haspopup="true"
    aria-controls="nav-drawer-panel"
    class="-ml-2 flex list-none cursor-pointer items-center rounded p-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2">
      <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </summary>

  <div data-menu-panel class="fixed inset-0 z-50">
    <div data-menu-backdrop class="absolute inset-0 bg-[#1c1917]/50"></div>
    <nav
      id="nav-drawer-panel"
      data-menu-drawer
      tabindex="-1"
      aria-label="Menú principal"
      class="relative z-10 flex h-full w-[85vw] max-w-xs flex-col overflow-y-auto bg-surface shadow-lg"
    >
      <ul class="flex-1">
        <li class="border-b border-border">
          <a href="/" class="block px-4 py-3 text-sm font-medium hover:text-brandInk focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]">Inicio</a>
        </li>
        <li>
          <%- include('./mega-menu', { menuTree }) %>
        </li>
      </ul>
    </nav>
  </div>
</details>
