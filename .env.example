# Secreto para firmar la cookie de sesión (express-session). Generalo con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Obligatorio en producción (el proceso no arranca sin esto si
# NODE_ENV=production); en desarrollo se autogenera uno temporal si falta,
# con un warning en consola.
SESSION_SECRET=reemplazar-con-el-hex-generado-por-el-comando-de-arriba
