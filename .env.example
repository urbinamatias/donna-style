DATABASE_URL=postgresql://donna:donna@localhost:5432/donna_style
PORT=3000
NODE_ENV=development

# Solo para `docker compose up -d db` (docker-compose.yml levanta ÚNICAMENTE
# Postgres, no la app). Si los cambiás, actualizá DATABASE_URL en consecuencia.
POSTGRES_USER=donna
POSTGRES_PASSWORD=donna
POSTGRES_DB=donna_style
# Puerto del host mapeado al 5432 del contenedor. Poné 5433 si ya tenés un
# Postgres local ocupando el 5432.
DB_HOST_PORT=5432

# Datos del cliente (§0 de prompt.md) — nunca hardcodeados en las vistas.
NOMBRE_TIENDA=Donna Style
# Fase 6d: WHATSAPP_ADMIN/INSTAGRAM/EMAIL_CONTACTO/CUIT pasan a ser el
# fallback de en MEDIO del resolver de 3 niveles (src/services/store-config.js):
# site_settings (panel /admin/configuracion, gana si hay un valor no vacío)
# → estas variables → default ficticio de desarrollo en src/config/env.js.
# Los valores de abajo son de ejemplo: en producción cargá los reales del
# cliente (son obligatorios con NODE_ENV=production, el proceso no arranca
# sin ellos).
WHATSAPP_ADMIN=5493510000000
INSTAGRAM=@tienda_ejemplo
EMAIL_CONTACTO=contacto@example.com
CUIT=27-00000000-6
# Base para armar el link del pedido en el mensaje de WhatsApp (§0).
SITE_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión (express-session). Generalo con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Obligatorio en producción (el proceso no arranca sin esto si
# NODE_ENV=production); en desarrollo se autogenera uno temporal si falta,
# con un warning en consola.
SESSION_SECRET=reemplazar-con-el-hex-generado-por-el-comando-de-arriba

# Solo los lee `npm run create-admin` (db/scripts/create-admin.js), que se
# corre UNA vez para dar de alta a la única admin. Los flags --email/--password
# le ganan a estas variables. Mínimo 8 caracteres. No hacen falta en runtime:
# borralas del entorno productivo después del alta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
